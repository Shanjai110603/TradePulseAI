FROM python:3.12-slim

WORKDIR /app

COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Playwright needs its browser binary AND a set of OS libraries installed —
# `pip install playwright` alone does NOT provide a working browser.
# This was missing from Dockerfile.backend, which is why browser-based
# login/scraping silently failed in every prior container deployment.
RUN playwright install --with-deps chromium

COPY backend/app ./app
COPY backend/uploads ./uploads

CMD ["python", "-m", "app.relay.quotex_browser_relay"]
