# Database Configuration
DATABASE_URL=sqlite+aiosqlite:///./tradepulse.db
REDIS_URL=redis://localhost:6379/0

# Security (Generate a secure random string in production)
SECRET_KEY=your_secure_random_jwt_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Telegram Bot Integration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=your_telegram_webhook_secret_token
TELEGRAM_TEST_MODE=false

# Market Data Configuration
MARKET_DATA_PROVIDER=quotex
QUOTEX_EMAIL=
QUOTEX_PASSWORD=
QUOTEX_SESSION_TOKEN=

# Shared secret the quotex_browser_relay must send to /markets/candles/ingest.
# Generate one with: python -c "import secrets; print(secrets.token_hex(24))"
RELAY_API_KEY=

# AI Provider Configuration
AI_PROVIDER=mock
AI_API_KEY=
OPENROUTER_API_KEY=
AI_MODEL=openai/gpt-4o-mini
