# ==============================================================================
# TradePulse Environment Configuration
# ==============================================================================

# Telegram Bot Integration
# Your bot token from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Comma-separated chat/channel IDs for public/VIP signal broadcasts (e.g. -100...)
TELEGRAM_CHAT_IDS=your_channel_id_here
# Comma-separated chat IDs authorized to run privileged admin commands (/pause, /resume, /status)
# CRITICAL: If left empty, ALL remote administrative commands are refused (fail-closed).
TELEGRAM_ADMIN_CHAT_IDS=your_admin_chat_id_here

# Local Webhook Relay Authentication (Optional shared secret token)
# Required if binding to non-loopback host (e.g. 0.0.0.0)
WEBHOOK_TOKEN=

# Quotex Account Credentials (Optional for Desktop if using in-app login)
QUOTEX_EMAIL=your_email@example.com
QUOTEX_PASSWORD=your_password
# Pre-authenticated session token (Bypasses login forms if present)
QUOTEX_SESSION_TOKEN=

# Proxy Configuration (Optional - Recommended for Cloud VPS to bypass datacenter IP blocks)
# Format: http://username:password@proxy_host:proxy_port or socks5://...
QUOTEX_PROXY=

# Regional WebSocket Endpoints (Multi-endpoint failover pool)
QUOTEX_WS_MIRRORS=wss://ws2.qxbroker.com/socket.io/?EIO=3&transport=websocket,wss://ws.market-qx.pro/socket.io/?EIO=3&transport=websocket,wss://ws.quotex.io/socket.io/?EIO=3&transport=websocket

# Application Settings
DATA_DIR=~/.tradepulse
MIN_PAYOUT_THRESHOLD=80
LOG_LEVEL=INFO
