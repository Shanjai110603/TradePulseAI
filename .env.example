# ==============================================================================
# TRADEPULSE AI ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=true
PORT=8000

# Database Configuration (PostgreSQL or SQLite Async Fallback)
# Local SQLite fallback: sqlite+aiosqlite:///./tradepulse.db
# PostgreSQL: postgresql+asyncpg://tradepulse_user:tradepulse_password@localhost:5432/tradepulse_db
DATABASE_URL=sqlite+aiosqlite:///./tradepulse.db
REDIS_URL=redis://localhost:6379/0

# Security & JWT Tokens
SECRET_KEY=tradepulse_super_secret_jwt_key_change_in_production_2026_x89
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Telegram Bot Integration
# Leave empty to run in local mock/test mode without needing a bot token
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_TEST_MODE=true

# Market Data Provider
# Available options: quotex (Quotex Digital Options & OTC) | mock (synthetic) | binance (crypto)
MARKET_DATA_PROVIDER=quotex
MARKET_DATA_API_KEY=

# AI Provider Abstraction
# Available options: openrouter (OpenRouter GPT-4o / Claude / DeepSeek) | mock | openai | anthropic | gemini
AI_PROVIDER=openrouter
AI_API_KEY=
OPENROUTER_API_KEY=
AI_MODEL=openai/gpt-4o-mini
AI_TEMPERATURE=0.2

# Storage & Uploads
UPLOAD_DIR=uploads/patterns
MAX_UPLOAD_SIZE_MB=5
